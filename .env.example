# Desenvolvimento local
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATA_DIR=./data

# Pix de cursos REAIS: ativar somente após publicar aulas e configurar HTTPS.
# Nunca inserir chaves reais no GitHub, páginas HTML ou mensagens públicas.
ENABLE_COURSE_PIX=false
